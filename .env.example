# آدرس کاملِ سایت، برای ساختن لینک داخل ایمیل‌ها (تأیید ایمیل، بازنشانی رمز)
NEXT_PUBLIC_SITE_URL=http://localhost


# ------------------------------------------------------- اولین حساب مدیر ----
# فقط برای راه‌اندازی اولیه. بعد از اینکه حساب ساخته شد، این دو را از .env
# بردارید تا رمز روی دیسک نماند — اسکریپت idempotent است و نبودشان را رد می‌کند.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=مدیر سروا

# ─────────────────────────────────────────────────────────────
# ورود با حساب گوگل (اختیاری)
# ─────────────────────────────────────────────────────────────
#
# اگر این دو خالی بمانند، قابلیت خاموش است و دکمه‌اش هم نمایش داده نمی‌شود؛
# سایت مثل قبل با ایمیل و رمز کار می‌کند. هیچ خطایی هم نمی‌دهد.
#
# ساختنشان در console.cloud.google.com:
#   APIs & Services → Credentials → Create credentials → OAuth client ID
#   نوع: Web application
#
# و در همان صفحه، این آدرس باید دقیقاً در Authorized redirect URIs باشد:
#
#   <NEXT_PUBLIC_SITE_URL>/api/v1/auth/google/callback
#
# مثلاً برای توسعهٔ محلی:  http://localhost:3000/api/v1/auth/google/callback
#
# ⚠️ آدرس بازگشت از NEXT_PUBLIC_SITE_URL ساخته می‌شود. اگر آن را عوض کنید،
# باید در کنسول گوگل هم عوضش کنید وگرنه گوگل با redirect_uri_mismatch رد
# می‌کند.
GOOGLE_CLIENT_ID=
# ⚠️ این یکی راز است — هرگز در کد، در گیت، یا در متغیرهای NEXT_PUBLIC_ نرود.
GOOGLE_CLIENT_SECRET=

# پوشهٔ کشِ تصاویرِ واترمارک‌شده.
#
# ⚠️ چرا مهم است: ساختنِ هر تصویر میانهٔ ۷۵ میلی‌ثانیه CPU می‌گیرد و پیش از
# این در هر درخواست تکرار می‌شد. با کش، درخواستِ دوم به بیست میلی‌ثانیه
# می‌رسد.
#
# خالی بگذارید تا از پوشهٔ موقتِ سیستم استفاده شود. روی داکر بهتر است یک
# volume بدهید تا با هر restart دوباره ساخته نشوند.
VOCAB_IMAGE_CACHE_DIR=
