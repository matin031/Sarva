# =============================================================================
# سروا — نمونهٔ تنظیمات
# =============================================================================
# کپی کنید به .env و مقادیر را پر کنید:
#     cp .env.example .env
#
# .env هرگز نباید commit شود (در .gitignore هست).
#
# برای ساختن هر کلید تصادفی:
#     openssl rand -base64 48
# یا اگر openssl ندارید:
#     node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# =============================================================================


# --------------------------------------------------------------- دیتابیس ----
# docker-compose خودش DATABASE_URL را از این سه می‌سازد؛ لازم نیست دستی بنویسید.
# (اگر بیرون از داکر `npm run dev` می‌زنید، DATABASE_URL را در .env.local بگذارید.)
POSTGRES_USER=sarva
POSTGRES_PASSWORD=
POSTGRES_DB=sarva

# پورتی که پستگرس روی هاست منتشر می‌شود — فقط برای وصل شدن با کلاینت گرافیکی.
# روی سرور عمومی خالی نگذارید؛ همین مقدار پیش‌فرض به لوپ‌بک محدود است.
POSTGRES_EXPOSE=127.0.0.1:5433


# ------------------------------------------------------------------ Auth ----
# کلید امضای JWT. عوض کردنش همهٔ سشن‌های فعال را باطل می‌کند (که گاهی دقیقاً
# همان چیزی است که می‌خواهید).
AUTH_JWT_SECRET=

# عمر توکن‌ها. access کوتاه است چون قابل ابطال نیست؛ refresh در دیتابیس ردیف
# دارد و هر لحظه می‌شود باطلش کرد. یعنی «مسدود کردن کاربر» حداکثر به اندازهٔ
# ACCESS_TTL طول می‌کشد تا کامل اثر کند.
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=30d

# روی http لوکال باید false باشد، وگرنه مرورگر کوکی را اصلاً نگه نمی‌دارد.
# روی production با HTTPS حتماً true.
AUTH_COOKIE_SECURE=false


# ------------------------------------------------------------------- OTP ----
# فلفلِ هش کدهای تأیید. در دیتابیس ذخیره نمی‌شود — نکتهٔ اصلی همین است: با لو
# رفتن دامپ دیتابیس، بدون این مقدار هیچ کدی قابل بازیابی نیست.
# عوض کردنش همهٔ کدهای در جریان را بی‌اعتبار می‌کند.
OTP_PEPPER=

OTP_TTL_MINUTES=10
# فاصلهٔ اجباری بین دو درخواست کد برای یک ایمیل
OTP_RESEND_COOLDOWN_SECONDS=60
# سقف ارسال در ۱۵ دقیقه، به ازای هر ایمیل
OTP_MAX_PER_EMAIL=3
# سقف ارسال در یک ساعت، به ازای هر IP
OTP_MAX_PER_IP=10
# سقف تلاشِ غلط برای یک کد؛ بعد از آن کد می‌سوزد حتی اگر منقضی نشده باشد
OTP_MAX_ATTEMPTS=5


# ----------------------------------------------------------------- ایمیل ----
# resend | smtp
MAIL_DRIVER=smtp

# آدرس فرستنده. این فقط مقدارِ اولیه است — ادمین می‌تواند از پنل عوضش کند و
# مقدارِ پنل بر این ارجحیت دارد. (تا امروز 'noreply@aruzino.ir' در کد هاردکد
# بود و عوض کردنش یعنی deploy دوباره.)
MAIL_FROM="سروا <noreply@example.com>"

# وقتی MAIL_DRIVER=resend
RESEND_API_KEY=

# وقتی MAIL_DRIVER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=


# ---------------------------------------------------------------- پیامک ----
# فعلاً هیچ بخشی از سایت پیامک نمی‌فرستد. آداپتر هست تا وقتی پنل پیامک خریدید،
# فقط همین چند خط عوض شود و نه کد.
# mock = چیزی ارسال نمی‌شود، فقط در لاگ و جدول sms_log ثبت می‌شود.
SMS_DRIVER=mock
SMS_API_KEY=
SMS_SENDER=


# ------------------------------------------------------------ ذخیره‌سازی ----
# local = روی دیسک خودِ سرور (volume داکر). برای مقیاس این پروژه کافی است.
# مسیرِ عمومیِ فایل‌ها را Caddy سرو می‌کند، نه Next.
STORAGE_DRIVER=local
UPLOADS_DIR=/app/uploads
# پیشوندی که در دیتابیس ذخیره می‌شود. اگر روزی به CDN رفتید، فقط همین عوض
# می‌شود و رکوردهای قبلی هم درست می‌مانند (چون مسیرِ نسبی ذخیره می‌شود).
UPLOADS_PUBLIC_BASE=/uploads
MAX_UPLOAD_MB=15


# ------------------------------------------------------------------ سایت ----
# آدرسی که Caddy روی آن گوش می‌دهد.
#   لوکال:      :80
#   production: sarva.example.com   (گواهی TLS خودکار گرفته می‌شود)
SITE_ADDRESS=:80
# ایمیل برای Let's Encrypt — فقط در production لازم است
ACME_EMAIL=

# آدرس کاملِ سایت، برای ساختن لینک داخل ایمیل‌ها (تأیید ایمیل، بازنشانی رمز)
NEXT_PUBLIC_SITE_URL=http://localhost


# ------------------------------------------------------- اولین حساب مدیر ----
# فقط برای راه‌اندازی اولیه. بعد از اینکه حساب ساخته شد، این دو را از .env
# بردارید تا رمز روی دیسک نماند — اسکریپت idempotent است و نبودشان را رد می‌کند.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=مدیر سروا
