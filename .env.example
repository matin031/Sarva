# =============================================================================
# سروا — نمونهٔ تنظیمات
# =============================================================================
# کپی کنید به .env و مقادیر را پر کنید:
#     cp .env.example .env
#
# .env هرگز نباید commit شود (در .gitignore هست).
#
# برای ساختن هر کلید تصادفی:
#     openssl rand -base64 48
# یا اگر openssl ندارید:
#     node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# =============================================================================


# --------------------------------------------------------------- دیتابیس ----
# docker-compose خودش DATABASE_URL را از این سه می‌سازد؛ لازم نیست دستی بنویسید.
# (اگر بیرون از داکر `npm run dev` می‌زنید، DATABASE_URL را در .env.local بگذارید.)
POSTGRES_USER=sarva
POSTGRES_PASSWORD=
POSTGRES_DB=sarva

# پورتی که پستگرس روی هاست منتشر می‌شود — فقط برای وصل شدن با کلاینت گرافیکی.
# روی سرور عمومی خالی نگذارید؛ همین مقدار پیش‌فرض به لوپ‌بک محدود است.
POSTGRES_EXPOSE=127.0.0.1:5433


# ------------------------------------------------------------------ Auth ----
# کلید امضای JWT. عوض کردنش همهٔ سشن‌های فعال را باطل می‌کند (که گاهی دقیقاً
# همان چیزی است که می‌خواهید).
AUTH_JWT_SECRET=

# عمر توکن‌ها. access کوتاه است چون قابل ابطال نیست؛ refresh در دیتابیس ردیف
# دارد و هر لحظه می‌شود باطلش کرد. یعنی «مسدود کردن کاربر» حداکثر به اندازهٔ
# ACCESS_TTL طول می‌کشد تا کامل اثر کند.
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=30d

# پرچم Secure کوکی سشن.
#
# دیگر لازم نیست دستی ست شود: در production پیش‌فرض true است. این خط فقط برای
# *غیرفعال* کردنِ عمدی است — مثلاً وقتی روی لوکال با NODE_ENV=production
# آزمایش می‌کنید و مرورگر روی http کوکی را نگه نمی‌دارد.
#
# (قبلاً پیش‌فرض false بود و فراموش کردنِ این خط روی سرور یعنی کوکی سشن روی
#  اتصال رمزنگاری‌نشده هم فرستاده می‌شد، بی‌هیچ خطا یا هشداری.)
# AUTH_COOKIE_SECURE=false


# ------------------------------------------------------------------- OTP ----
# فلفلِ هش کدهای تأیید. در دیتابیس ذخیره نمی‌شود — نکتهٔ اصلی همین است: با لو
# رفتن دامپ دیتابیس، بدون این مقدار هیچ کدی قابل بازیابی نیست.
# عوض کردنش همهٔ کدهای در جریان را بی‌اعتبار می‌کند.
OTP_PEPPER=

OTP_TTL_MINUTES=10
# فاصلهٔ اجباری بین دو درخواست کد برای یک ایمیل
OTP_RESEND_COOLDOWN_SECONDS=60
# سقف ارسال در ۱۵ دقیقه، به ازای هر ایمیل
OTP_MAX_PER_EMAIL=3
# سقف ارسال در یک ساعت، به ازای هر IP
OTP_MAX_PER_IP=10
# سقف تلاشِ غلط برای یک کد؛ بعد از آن کد می‌سوزد حتی اگر منقضی نشده باشد
OTP_MAX_ATTEMPTS=5


# ----------------------------------------------------------------- ایمیل ----
# resend | smtp
MAIL_DRIVER=smtp

# آدرس فرستنده. این فقط مقدارِ اولیه است — ادمین می‌تواند از پنل عوضش کند و
# مقدارِ پنل بر این ارجحیت دارد. (تا امروز 'noreply@aruzino.ir' در کد هاردکد
# بود و عوض کردنش یعنی deploy دوباره.)
MAIL_FROM="سروا <noreply@example.com>"

# وقتی MAIL_DRIVER=resend
RESEND_API_KEY=

# وقتی MAIL_DRIVER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=


# ---------------------------------------------------------------- پیامک ----
# فعلاً هیچ بخشی از سایت پیامک نمی‌فرستد. آداپتر هست تا وقتی پنل پیامک خریدید،
# فقط همین چند خط عوض شود و نه کد.
# mock = چیزی ارسال نمی‌شود، فقط در لاگ و جدول sms_log ثبت می‌شود.
SMS_DRIVER=mock
SMS_API_KEY=
SMS_SENDER=


# ----------------------------------------------------------------- کپچا ----
# Cloudflare Turnstile — رایگان و بدون سقف.
#
# تا وقتی TURNSTILE_SECRET_KEY خالی باشد کپچا کاملاً خاموش است و سایت مثل قبل
# کار می‌کند. برای فعال کردنش:
#
#   ۱) dash.cloudflare.com → Turnstile → Add Site
#      (نیازی نیست دامنه‌تان را به Cloudflare منتقل کنید)
#   ۲) دامنهٔ سایت را وارد کنید و «localhost» را هم به‌عنوان دامنهٔ دوم اضافه
#      کنید، وگرنه محیط توسعه کار نمی‌کند. Widget Mode = Managed
#   ۳) دو کلیدی که می‌دهد را اینجا بگذارید و کانتینر را ری‌استارت کنید.
#
# SITE_KEY عمومی است و در HTML صفحه می‌نشیند؛ SECRET_KEY هرگز از سرور بیرون
# نمی‌رود.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=


# ------------------------------------------------------- محدودیت نرخ ----
# سقف کلی درخواست به ازای هر IP روی /api در هر دقیقه. محدودیت‌های دقیق‌ترِ هر
# endpoint (ورود، ثبت‌نام، آپلود و…) جدا و سخت‌گیرانه‌ترند؛ این فقط کفِ محافظت
# در برابر اسکریپت است. کاربر عادی هرگز به آن نمی‌خورد.
API_RATE_LIMIT=240

# سقف /api/vocab-image در دقیقه به ازای هر IP. هر درخواست یک پردازش تصویر با
# sharp است، پس گران‌ترین endpoint سایت است.
VOCAB_IMAGE_RATE_LIMIT=60

# چند پروکسی جلوی اپ نشسته‌اند؟
#
# با معماری فعلی (فقط Caddy) مقدار درست ۱ است و لازم نیست دست بزنید. اگر روزی
# پروکسی دیگری هم جلوی Caddy آمد (Cloudflare، یک load balancer)، این عدد باید
# تعداد کلِ آن‌ها باشد — وگرنه محدودیت‌های مبتنی بر IP یا اشتباه IP را
# می‌شمارند یا قابل جعل می‌شوند.
TRUSTED_PROXY_HOPS=1


# ------------------------------------------------------- لاگ و رصدپذیری ----
# سایت سه لاگِ جدا دارد و هر سه با «شناسهٔ درخواست» به هم وصل‌اند:
#
#   ۱) لاگ عملیاتی → stdout کانتینر، با `docker compose logs -f app`
#   ۲) لاگ خطا     → جدول app_error_log و صفحهٔ /admin/activity
#   ۳) لاگ ممیزی   → جدول admin_audit_log و همان صفحه
#
# برای دنبال کردن یک مشکل: شناسهٔ درخواست را از /admin/activity کپی کنید و
#     docker compose logs app | grep <شناسه>
# تمام خطوطِ همان درخواست پشت سر هم می‌آیند.

# چقدر پرحرف باشد: trace | debug | info | warn | error | fatal | silent
#
# پیش‌فرض در production همان info است و برای همیشه مناسب می‌ماند: هر درخواست
# API یک خط، به‌علاوهٔ رخدادهای مهم (ورود، ایمیل، آپلود) و همهٔ خطاها.
#
# debug فقط وقتی لازم است که دنبال چیز خاصی می‌گردید — و بعدش برش گردانید،
# وگرنه لاگ سریع می‌چرخد و همان چیزی که می‌خواستید ببینید بیرون می‌رود.
LOG_LEVEL=info

# قالب خروجی: json | pretty
#
# در docker-compose برای سرویس app روی json ثابت شده (یک خط JSON با grep و jq
# قابل کار است). این خط فقط برای اجرای محلیِ بیرون از داکر است.
# LOG_FORMAT=pretty

# نسخهٔ در حال اجرا — هر رشته‌ای که برای شما معنا دارد: تگ گیت، تاریخ، شمارهٔ
# انتشار. خالی هم بماند همه‌چیز کار می‌کند.
#
# به چه درد می‌خورد: هر خطا در /admin/activity کنارش نسخه‌ای را نشان می‌دهد که
# در آن رخ داده. بدونش، بعد از هر انتشار معلوم نیست خطا تازه است یا از قبل
# بوده.
#
#     APP_RELEASE=$(git rev-parse --short HEAD)
APP_RELEASE=

# کوئری کندتر از این (میلی‌ثانیه) با رخداد db.query.slow در لاگ می‌نشیند.
#
# ۵۰۰ پیش‌فرضِ محافظه‌کارانه‌ای است: کوئری‌های این پروژه در حالت سالم زیر ۵۰
# میلی‌ثانیه‌اند، پس هر چیزی که به این عدد برسد واقعاً جای نگاه کردن دارد.
# پایین‌تر آوردنش لاگ را شلوغ می‌کند، بالاتر بردنش مشکل را پنهان.
DB_SLOW_QUERY_MS=500

# نمونه‌گیریِ لاگِ درخواست‌های *موفق* — عددی بین ۰ و ۱.
#
# ۱ یعنی همه لاگ شوند، که برای مقیاس این سایت درست است. اگر روزی ترافیک
# آن‌قدر زیاد شد که لاگ آزاردهنده شد، ۰.۱ یعنی «یکی از هر ده». خطاها، ۴۲۹ ها
# و درخواست‌های کند *هرگز* نمونه‌گیری نمی‌شوند و همیشه کامل می‌آیند.
HTTP_LOG_SAMPLE=1

# درخواست کندتر از این (میلی‌ثانیه) همیشه لاگ می‌شود، حتی اگر نمونه‌گیری
# ردش کرده باشد.
HTTP_SLOW_REQUEST_MS=1500


# ------------------------------------------------------------ ذخیره‌سازی ----
# local = روی دیسک خودِ سرور (volume داکر). برای مقیاس این پروژه کافی است.
# مسیرِ عمومیِ فایل‌ها را Caddy سرو می‌کند، نه Next.
STORAGE_DRIVER=local
UPLOADS_DIR=/app/uploads
# پیشوندی که در دیتابیس ذخیره می‌شود. اگر روزی به CDN رفتید، فقط همین عوض
# می‌شود و رکوردهای قبلی هم درست می‌مانند (چون مسیرِ نسبی ذخیره می‌شود).
UPLOADS_PUBLIC_BASE=/uploads
MAX_UPLOAD_MB=15


# ------------------------------------------------------------------ سایت ----
# آدرسی که Caddy روی آن گوش می‌دهد.
#   لوکال:      :80
#   production: sarva.example.com   (گواهی TLS خودکار گرفته می‌شود)
SITE_ADDRESS=:80
# ایمیل برای Let's Encrypt — فقط در production لازم است
ACME_EMAIL=

# آدرس کاملِ سایت، برای ساختن لینک داخل ایمیل‌ها (تأیید ایمیل، بازنشانی رمز)
NEXT_PUBLIC_SITE_URL=http://localhost


# ------------------------------------------------------- اولین حساب مدیر ----
# فقط برای راه‌اندازی اولیه. بعد از اینکه حساب ساخته شد، این دو را از .env
# بردارید تا رمز روی دیسک نماند — اسکریپت idempotent است و نبودشان را رد می‌کند.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=مدیر سروا
