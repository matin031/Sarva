# =============================================================================
#  تنظیمات سروا  —  این فایل را به .env تغییر نام دهید
# =============================================================================
#
#  چطور: در File Manager روی این فایل راست‌کلیک → Rename → بنویسید:  .env
#  بعد راست‌کلیک → Edit و مقدارها را پر کنید.
#
#  ⚠️ بعد از هر تغییر در این فایل، باید در cPanel دکمهٔ RESTART برنامه را
#     بزنید. تا وقتی restart نکنید، هیچ تغییری اثر ندارد.
#
#  ⚠️ هیچ‌وقت این فایل را برای کسی نفرستید. کلیدهای داخلش مثل کلید خانه‌اند.
# =============================================================================


# -----------------------------------------------------------------------------
#  ۱) دیتابیس  (اجباری)
# -----------------------------------------------------------------------------
#  این چهار چیز را از بخش «MySQL Databases» در cPanel برمی‌دارید:
#
#      نام کاربری، رمز، نام دیتابیس
#
#  ⚠️ در هاست اشتراکی، cPanel به نام دیتابیس و کاربر یک پیشوند اضافه می‌کند.
#     مثلاً اگر نام حسابتان sarvaedu باشد و دیتابیس را sarva بنامید، نام
#     واقعی می‌شود:  sarvaedu_sarva
#     همان نامِ کاملِ با پیشوند را اینجا بنویسید.
#
#  ⚠️ اگر رمز دیتابیس یکی از این نویسه‌ها را دارد، خط زیر کار نمی‌کند:
#
#          @   :   /   ?   #   و فاصله
#
#     ساده‌ترین راه: در cPanel رمز را عوض کنید و از دکمهٔ Password Generator
#     استفاده کنید، ولی نویسه‌های ویژه‌اش را حذف کنید تا فقط حرف و عدد بماند.
#
#  الگو:   mysql://کاربر:رمز@localhost:3306/نام‌دیتابیس

DATABASE_URL=mysql://sarvaedu_user:RAMZ@localhost:3306/sarvaedu_sarva


# -----------------------------------------------------------------------------
#  ۲) کلیدهای امنیتی  (اجباری)
# -----------------------------------------------------------------------------
#  این دو کلید باید تصادفی و طولانی باشند. خودتان چیزی ننویسید.
#
#  ⚠️ عوض کردن کلید اول، همهٔ کاربرانی را که وارد شده‌اند بیرون می‌اندازد.
#     یک بار بگذارید و دیگر دست نزنید.
#
#  اگر جای دیگری برای ساختنش ندارید، از این سایت بگیرید:
#      https://generate-random.org/api-key-generator
#  دو رشتهٔ ۶۰ نویسه‌ای بسازید و اینجا بگذارید.

AUTH_JWT_SECRET=
OTP_PEPPER=

#  مدتِ وارد ماندنِ کاربر (اختیاری — اگر ننویسید همین مقدارها اعمال می‌شوند)
#
#  AUTH_REFRESH_TTL  همان «چند روز وارد بمانم؟» است. ۳۰ روز.
#  AUTH_ACCESS_TTL   فقط عمرِ توکنِ کوتاه است و خودکار تمدید می‌شود؛
#                    کاربر هیچ‌وقت حسِ این یکی را نمی‌کند.
#
#  ⚠️ مهلت از لحظهٔ ورود حساب می‌شود و با هر باز کردنِ سایت تمدید
#     نمی‌شود — عمدی است، تا کسی که توکنِ دزدیده دارد نتواند تا ابد
#     زنده نگهش دارد.
#
#  ⚠️ شکلِ مقدار مهم است: عدد به‌علاوهٔ s/m/h/d بدونِ فاصله (مثلاً 30d).
#     «30 days» یا «1w» خطا نمی‌دهد — بی‌صدا به پیش‌فرض برمی‌گردد.

AUTH_REFRESH_TTL=30d
AUTH_ACCESS_TTL=15m


# -----------------------------------------------------------------------------
#  ۳) اولین حساب مدیر  (فقط بار اول)
# -----------------------------------------------------------------------------
#  با این دو، اولین بار که برنامه بالا بیاید حساب مدیر ساخته می‌شود.
#
#  ⚠️ بعد از اینکه یک بار وارد شدید، این دو خط را پاک کنید و restart بزنید.
#     نگه داشتنِ رمز در یک فایل روی سرور، بی‌دلیل ریسک است.
#
#  رمز باید حداقل ۸ نویسه باشد.

ADMIN_EMAIL=
ADMIN_PASSWORD=


# -----------------------------------------------------------------------------
#  ۴) آدرس سایت
# -----------------------------------------------------------------------------
#  بدون / در انتها.
#
#  ⚠️ این یکی فرق مهمی با بقیهٔ متغیرهای این فایل دارد:
#
#  هر متغیری که با NEXT_PUBLIC_ شروع می‌شود را Next در زمان **build**
#  داخلِ خودِ کد می‌نویسد — نه در زمانِ اجرا. و بیلدِ این پروژه روی
#  هاست انجام نمی‌شود؛ روی کامپیوترِ خودتان انجام می‌شود.
#
#  یعنی **عوض کردنِ این خط روی هاست هیچ اثری ندارد.** مقداری که
#  سایت استفاده می‌کند، همانی است که موقعِ `npm run build` در `.env.production.local`
#  (یا `.env.local`) روی ماشینِ بیلد بوده.
#
#  یک بار همین سایت را خراب کرد: بیلد با http://localhost:3000 گرفته شده بود،
#  پس sitemap و robots و canonical و لینکِ دعوتِ کلاس همه به localhost اشاره
#  می‌کردند — بی آنکه خطایی در کار باشد.
#
#  از این پس دو نگهبان هست: `npm run host:build` اگر بیلد با آدرسِ محلی
#  گرفته شده باشد بسته را نمی‌سازد، و خودِ برنامه هم در production هر
#  آدرسِ localhost را کنار می‌گذارد و به https://sarvaedu.ir برمی‌گردد.
#
#  (این خط را با همان مقدار نگه دارید: جاهایی که در زمانِ اجرا خوانده
#   می‌شود — مثلاً بررسیِ CSRF و آدرسِ بازگشتِ گوگل — هنوز همین را
#   می‌بینند.)

NEXT_PUBLIC_SITE_URL=https://sarvaedu.ir


# -----------------------------------------------------------------------------
#  ۵) ایمیل  (برای تأیید ثبت‌نام و بازیابی رمز)
# -----------------------------------------------------------------------------
#  ⚠️ تا وقتی این‌ها را پر نکنید، کاربران ایمیل تأیید نمی‌گیرند و عملاً
#     نمی‌توانند ثبت‌نام کنند. بقیهٔ سایت کار می‌کند.
#
#  در cPanel از بخش «حساب‌های ایمیل» یک ایمیل بسازید (مثلاً
#  no-reply@sarvaedu.ir) و مشخصاتش را اینجا بگذارید.

MAIL_DRIVER=smtp
SMTP_HOST=mail.sarvaedu.ir
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@sarvaedu.ir
SMTP_PASSWORD=
MAIL_FROM="سروا <no-reply@sarvaedu.ir>"

#  ⚠️ SMTP_PORT و SMTP_SECURE با هم معنا دارند و اشتباه گرفتنشان رایج است:
#        پورت ۴۶۵  →  SMTP_SECURE=true
#        پورت ۵۸۷  →  SMTP_SECURE=false
#     اگر جفت نباشند، ایمیل بدون خطای روشن فرستاده نمی‌شود.


# -----------------------------------------------------------------------------
#  ۶) کپچا  (اجباری — یکی از دو راه را انتخاب کنید)
# -----------------------------------------------------------------------------
#
#  ⚠️ این بخش را رد نکنید. اگر هیچ‌کدام از دو راه زیر را انجام ندهید،
#     **هیچ‌کس نمی‌تواند وارد سایت شود** — حتی خود شما — و پیامی که می‌گیرید
#     این است: «تأیید امنیتی پیکربندی نشده است».
#
#     این عمدی است: نبودِ کپچا در سایت واقعی یعنی رباتها می‌توانند هزاران
#     حساب بسازند و رمزها را امتحان کنند. پس سایت ترجیح می‌دهد بسته بماند
#     تا اینکه بی‌صدا بی‌محافظ باشد.
#
#
#  ── راه اول (توصیه‌شده): کپچای رایگان کلودفلر ────────────────────────────
#
#     ۱) به dash.cloudflare.com بروید (ثبت‌نام رایگان است)
#     ۲) از منوی چپ: Turnstile  →  Add Site
#     ۳) در Domain بنویسید:  sarvaedu.ir
#     ۴) Widget Mode را روی Managed بگذارید و Create بزنید
#     ۵) دو کلید می‌دهد. هر دو را اینجا بگذارید:
#
#     (کلید اول عمومی است و در صفحهٔ سایت دیده می‌شود — اشکالی ندارد.
#      کلید دوم مخفی است و هرگز نباید جایی منتشر شود.)

NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=


#  ── راه دوم: فعلاً بدون کپچا ─────────────────────────────────────────────
#
#     اگر می‌خواهید سایت را زودتر بالا بیاورید و کپچا را بعداً اضافه کنید،
#     دو خط بالا را خالی بگذارید و علامت # را از ابتدای خط زیر بردارید:
#
# TURNSTILE_OPTIONAL=true
#
#     ⚠️ در این حالت فرم ثبت‌نام و ورود هیچ محافظی ندارد. برای چند روزِ اول
#        قابل قبول است؛ برای همیشه نه.


# -----------------------------------------------------------------------------
#  ۷) چیزهایی که معمولاً دست نمی‌خورند
# -----------------------------------------------------------------------------

NODE_ENV=production
LOG_FORMAT=json

#  سقف حجم هر فایل صوتی که مدیر آپلود می‌کند (مگابایت)
MAX_UPLOAD_MB=15

#  محلِ نگهداریِ حکم‌های کارگزینیِ درخواست‌های دبیری.
#
#  ⚠️ این پوشه **نباید** جایی باشد که وب‌سرور مستقیم سرو می‌کند.
#
#  بقیهٔ فایل‌های آپلودی (صوتِ کوییز، نگاره‌ها) عمداً عمومی‌اند و از
#  `/uploads` سرو می‌شوند. این یکی سندِ هویتی است و تنها راهِ دیدنش یک مسیرِ
#  پشتِ احراز هویتِ مدیر است
#  (`/api/v1/admin/teacher-requests/[id]/document`).
#
#  خالی گذاشتنش امن است: پیش‌فرض `private-uploads/teacher-docs` کنارِ خودِ
#  برنامه است که بیرونِ ریشهٔ عمومی قرار دارد. اگر مقداری بدهید، برنامه در
#  زمانِ اجرا بررسی می‌کند که داخلِ پوشهٔ عمومی نباشد و اگر بود با خطا
#  می‌ایستد — یعنی یک پیکربندیِ اشتباه بی‌صدا رد نمی‌شود.
#
#  ⚠️ و یادتان باشد در نسخهٔ پشتیبان بگیریدش: با رفتنِ این پوشه، مدیر دیگر
#  نمی‌تواند هیچ درخواستِ در انتظاری را بررسی کند.
# TEACHER_DOCS_DIR=


# =============================================================================
#  ⛔ از اینجا به بعد به هاست ربطی ندارد
# =============================================================================
#
#  این چند مقدار فقط وقتی لازم‌اند که کسی بخواهد پروژه را روی کامپیوتر خودش
#  با Docker بالا بیاورد. روی هاست cPanel هیچ‌کدامشان استفاده نمی‌شوند.
#
#  ⚠️ اگر روی هاست هستید، همین‌طور دست‌نخورده رهایشان کنید.
#
#  (تا دیروز این‌ها در یک فایل .env.example جداگانه بودند و همان باعث شد یک
#   بار سایت بالا نیاید: فایل داکری DATABASE_URL نداشت و در عوض
#   UPLOADS_DIR را روی مسیر داخلِ کانتینر می‌گذاشت، که روی هاست وجود ندارد.
#   حالا یک فایل بیشتر نیست تا انتخاب اشتباهی در کار نباشد.)

# نام و رمز دیتابیسی که docker compose می‌سازد
MYSQL_USER=sarva
MYSQL_PASSWORD=
MYSQL_DATABASE=sarva
MYSQL_ROOT_PASSWORD=

# پورتی که MySQL روی ماشین محلی منتشر می‌شود
MYSQL_EXPOSE=127.0.0.1:3306

# دامنه‌ای که Caddy روی آن گواهی می‌گیرد. برای محلی همین ":80" درست است.
SITE_ADDRESS=:80
ACME_EMAIL=

# ⚠️ NEXT_PUBLIC_SITE_URL اینجا دوباره تعریف نمی‌شود؛ جایش بخش ۴ بالاست.
# (یک merge هر دو طرف را نگه داشته بود و چون در فایلِ env مقدارِ آخر برنده
#  است، همین خط داشت آدرسِ production را با http://localhost می‌پوشاند.)


# ------------------------------------------------------- اولین حساب مدیر ----
# ⚠️ ADMIN_EMAIL و ADMIN_PASSWORD هم بالا در بخش ۳ هستند — همان دلیل.
# فقط نامِ نمایشیِ مدیر اینجا اضافه می‌شود.
ADMIN_NAME=مدیر سروا

# ─────────────────────────────────────────────────────────────
# ورود با حساب گوگل (اختیاری)
# ─────────────────────────────────────────────────────────────
#
# اگر این دو خالی بمانند، قابلیت خاموش است و دکمه‌اش هم نمایش داده نمی‌شود؛
# سایت مثل قبل با ایمیل و رمز کار می‌کند. هیچ خطایی هم نمی‌دهد.
#
# ساختنشان در console.cloud.google.com:
#   APIs & Services → Credentials → Create credentials → OAuth client ID
#   نوع: Web application
#
# و در همان صفحه، این آدرس باید دقیقاً در Authorized redirect URIs باشد:
#
#   <NEXT_PUBLIC_SITE_URL>/api/v1/auth/google/callback
#
# مثلاً برای توسعهٔ محلی:  http://localhost:3000/api/v1/auth/google/callback
#
# ⚠️ آدرس بازگشت از NEXT_PUBLIC_SITE_URL ساخته می‌شود. اگر آن را عوض کنید،
# باید در کنسول گوگل هم عوضش کنید وگرنه گوگل با redirect_uri_mismatch رد
# می‌کند.
GOOGLE_CLIENT_ID=
# ⚠️ این یکی راز است — هرگز در کد، در گیت، یا در متغیرهای NEXT_PUBLIC_ نرود.
GOOGLE_CLIENT_SECRET=

# پوشهٔ کشِ تصاویرِ واترمارک‌شده.
#
# ⚠️ چرا مهم است: ساختنِ هر تصویر میانهٔ ۷۵ میلی‌ثانیه CPU می‌گیرد و پیش از
# این در هر درخواست تکرار می‌شد. با کش، درخواستِ دوم به بیست میلی‌ثانیه
# می‌رسد.
#
# خالی بگذارید تا از پوشهٔ موقتِ سیستم استفاده شود. روی داکر بهتر است یک
# volume بدهید تا با هر restart دوباره ساخته نشوند.
VOCAB_IMAGE_CACHE_DIR=

# ─────────────────────────────────────────────────────────────────────────────
# سروا پلاس (اشتراک پولی)
# ─────────────────────────────────────────────────────────────────────────────
# ⚠️ همهٔ این‌ها از پنل مدیریت هم قابل تنظیم‌اند و مقدارِ پنل برنده است؛
# این‌ها فقط مقدارِ اولیهٔ یک سرورِ تازه‌اند.
#
# پیش‌فرضِ نانوشته «خاموش» است و این عمدی است: یک deploy نباید به‌خودیِ‌خود
# سایتی را که تا دیروز رایگان بوده پولی کند.

# on | off — روشن/خاموش کردنِ کلِ فروش و قفل‌های سروا پلاس.
PLUS_ENABLED=

# چند روز مانده به پایان، هشدارِ آرامِ «نزدیک پایان» نشان داده شود (۱ تا ۳۰).
PLUS_EXPIRING_SOON_DAYS=

# نامِ آداپتورِ درگاه. تا وقتی درگاه واقعی وصل نشده «test» بماند.
# ⚠️ آداپتورِ آزمایشی روی سرورِ اصلی اجازهٔ کار ندارد و صریحاً خطا می‌دهد،
# تا هیچ‌وقت یک «پرداخت موفقِ» جعلی ساخته نشود.
PLUS_PAYMENT_PROVIDER=test

# خلاصهٔ شرایط خرید که پیش از دکمهٔ پرداخت نشان داده می‌شود.
# ⚠️ سروا متنِ حقوقی تولید نمی‌کند؛ تا وقتی خالی باشد، صفحهٔ پرداخت صریحاً
# می‌گوید شرایطی ثبت نشده است.
PLUS_PURCHASE_TERMS=

# on | off — اجازهٔ «فعال‌سازی آزمایشی بدون پرداخت» برای مدیر، در دورهٔ پایلوت.
PLUS_PILOT_GRANT_ENABLED=

# ─────────────────────────────────────────────────────────────────────────────
# پیامک  (SMS.ir)
# ─────────────────────────────────────────────────────────────────────────────
#
# ⚠️ راهِ درستِ راه‌اندازی، پنلِ مدیر است و نه این فایل: /admin/settings →
#    بخشِ پیامک. تنظیماتِ دیتابیس بر متغیرهای محیطی اولویت دارند، پس این‌ها
#    فقط مقدارِ پیش‌فرض‌اند برای وقتی هنوز چیزی در پنل ثبت نشده.
#
# ⚠️ کلیدِ واقعی هرگز در این فایل یا هر فایلِ دیگری از مخزن نوشته نمی‌شود.
#    این فایل در گیت است و هر چه اینجا بنشیند، برای همیشه در تاریخچه می‌ماند.

# ⚠️ پیامک اختیاری نیست.
#
#    ورود با موبایل، ثبت‌نام، بازیابی رمز و تأییدِ شمارهٔ دبیران همه با کدِ
#    پیامکی کار می‌کنند. با `mock` هیچ کدی ارسال نمی‌شود و کاربر تا ابد
#    منتظر می‌ماند — بدونِ اینکه خطایی ببیند.

# mock = غیرفعال (فقط در گزارش ثبت می‌شود) | smsir = ارسال واقعی با SMS.ir
SMS_DRIVER=mock

# کلیدِ API از پنلِ SMS.ir: «برنامه‌نویسان → لیست کلیدهای API».
SMS_API_KEY=

# شناسهٔ قالبِ تأییدشده‌ای که کدِ ورود با آن می‌رود — عددی که در
# «لیست قالب‌ها»ی پنلِ SMS.ir کنارِ قالب نوشته شده.
# ⚠️ قالب باید دقیقاً یک متغیر به نامِ Code داشته باشد (#CODE#).
# ⚠️ در کد هاردکد نشده: بدونِ این مقدار (یا مقدارِ متناظرش در پنلِ مدیر)
#    هیچ کدی ارسال نمی‌شود.
SMS_TEMPLATE_ID=

